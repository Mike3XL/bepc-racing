# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# WebScorer API ID — required for fetching BEPC and Sound Rowers races
# Get from: Organizers / My organizer settings on webscorer.com
# ("Unique organizer URL" — the digits at the end are your API ID)
WEBSCORER_API_ID=your_api_id_here

# WebScorer API Token (apipriv) — required alongside the API ID since ~2026-07.
# Requires an active PRO Results subscription (separate from PRO Timing).
# Get from: Organizers / My organizer settings > JSON API Token section
WEBSCORER_API_TOKEN=your_api_token_here
